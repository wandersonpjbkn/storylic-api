{
  "name": "storylic-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "resolutions": {
    "typescript": "~5.7.2",
    "qs": "^6.15.2",
    "path-to-regexp": "0.1.13",
    "socket.io-parser": "^4.2.6",
    "ws": "^8.21.0"
  },
  "scripts": {
    "dev": "tsx watch -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --fix",
    "ts": "tsc --noEmit",
    "audit:deps": "yarn audit --groups dependencies --level moderate; c=$?; [ $((c & 28)) -eq 0 ]",
    "security": "yarn audit:deps && yarn lint",
    "security:deep": "bash scripts/codeql-scan.sh"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "globals": "^15.12.0",
    "jiti": "^2.6.1",
    "socket.io-client": "^4.8.3",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.10"
  }
}
