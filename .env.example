# Porta do servidor (default: 3000)
API_PORT=3000

# Host para bind em desenvolvimento (opcional)
API_LOCALHOST=127.0.0.1

# Origins permitidas pelo CORS — separadas por vírgula
# OBRIGATÓRIO em produção. Em desenvolvimento, usa localhost automaticamente.
# Exemplo: CORS_ORIGIN=https://storylic.onrender.com,https://www.storylic.com
CORS_ORIGIN=
