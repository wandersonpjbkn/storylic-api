# Porta do servidor (default: 3000)
API_PORT=3000

# Host para bind em desenvolvimento (opcional)
API_LOCALHOST=127.0.0.1

# Origins permitidas pelo CORS — separadas por vírgula
# OBRIGATÓRIO em produção.
# Exemplo: CORS_ORIGIN=https://<your.domain.com>
CORS_ORIGIN=
LOCAL_CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ── Modo clube local (LAN) ────────────────────────────────────────────────
# Caminho para o build do frontend (storylic/dist). Se definido, este servidor
# também serve o site, permitindo jogar 100% offline num notebook na rede local.
# Deixe vazio em produção na nuvem.
# Exemplo: PUBLIC_DIR=../storylic/dist
PUBLIC_DIR=

# ── Ajustes de tempo (opcionais) ──────────────────────────────────────────
# Folga (ms) que o watchdog dá além de (tempo de cards + narração) antes de
# avançar o turno sozinho caso o jogador da vez trave/minimize o app. Default 8000.
TURN_GRACE_MS=
# Janela (ms) de reserva da vaga após uma desconexão, para permitir reconexão.
# Default 60000 (60s).
RESERVATION_TTL_MS=

# ── Persistência (opcional) ───────────────────────────────────────────────
# URL de conexão do Redis (ex.: Upstash free tier, formato rediss://...).
# Deixe vazio para desativar a persistência — o servidor roda 100% em memória
# como hoje, sem sobreviver a redeploy/spindown.
REDIS_URL=
